# Application
APP_NAME=CampusIQ AI
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (development values only; never commit real credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusiq_ai
DB_USER=campusiq_app
DB_PASSWORD=replace-with-a-local-secret
DB_ECHO=false
